<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="0dp"
    android:layout_marginRight="0dp"
    android:background="@color/LayoutColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarCP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/BoxColor"
            android:title=""
            android:titleTextColor="@color/white"
            tools:ignore="NewApi">

            <TextView
                android:id="@+id/toolbarTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DuitNow QR"
                android:layout_gravity="center"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="25sp"/>
        </androidx.appcompat.widget.Toolbar>

        <ImageView
            android:id="@+id/qrBrandImage"
            android:adjustViewBounds="true"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/currencyBox"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp">

            <TextView
                android:id="@+id/textView_currency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/currency"
                android:textColor="@color/WordColor"
                android:textSize="50sp" />

            <TextView
                android:id="@+id/textView_amountDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amount"
                android:textColor="@color/WordColor"
                android:textSize="50sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/qrBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="20dp">
            <ImageView
                android:id="@+id/qrImg"
                android:layout_width="250dp"
                android:layout_height="250dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/barcodeImg"
            android:layout_width="280dp"
            android:layout_height="100dp"
            android:layout_marginTop="20dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/timerTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/gothamrounded_bold"
            android:gravity="center"
            android:text=""
            android:textSize="20sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>