<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MainActivity"
    android:orientation="vertical"
    android:background="@color/LayoutColor"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/LayoutMain_1"
        android:layout_width="match_parent"
        android:layout_height="107dp"
        android:background="@mipmap/logo"
        android:orientation="vertical"
        android:visibility="gone">
    </LinearLayout>

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridLayout2"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:columnCount="2">

        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:background="@drawable/custom_ripple_with_stoke"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginLeft="5dp"
            android:onClick="goAttend">

            <ImageView
                android:id="@+id/imageEdit"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@mipmap/attend_icon"
                android:contentDescription="@string/todo"
                android:padding="100dp" />

            <TextView
                android:id="@+id/textViewTerminalPay1"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="@string/attend_machine"
                android:textColor="@color/ButtonWordColor"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.gridlayout.widget.GridLayout>

</LinearLayout>