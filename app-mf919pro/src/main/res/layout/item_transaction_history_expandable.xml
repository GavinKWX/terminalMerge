            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="View Details"
            android:textAllCaps="false" />-->
    </LinearLayout>

</LinearLayout>