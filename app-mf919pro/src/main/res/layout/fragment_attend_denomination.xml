<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header (15%) -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="15dp"
        android:layout_marginHorizontal="25dp"
        android:paddingVertical="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.15">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:adjustViewBounds="true"
            android:scaleType="center" />
        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="0dp" />

        <ImageView
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType= "fitCenter"
            android:src="@mipmap/logo" />
        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="0dp" />

        <ImageView
            android:id="@+id/headerSettingButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:adjustViewBounds="true"
            android:scaleType="center"
            android:background="@drawable/gear_icon" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvIP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        android:text="" />

    <LinearLayout
        android:id="@+id/linearStartPurchase"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginHorizontal="15dp"
        android:background="@drawable/custom_red_with_stoke"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone">
        <ImageView
            android:id="@+id/imageEdit"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@mipmap/unattended_icon"
            android:contentDescription="@string/todo"
            />

        <TextView
            android:id="@+id/textViewTerminalPay1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/start_purchase"
            android:textColor="@color/ButtonWordColor"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ViewPager (75%) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tokenViewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/footerText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <me.relex.circleindicator.CircleIndicator3
        android:id="@+id/indicator"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:translationZ="4dp"
        app:ci_drawable="@drawable/white_circle_indicator"
        app:ci_drawable_unselected="@drawable/black_circle_indicator"
        android:elevation="40dp"
        android:layout_marginBottom="5dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toTopOf="@id/footerText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Footer (10%) -->
    <TextView
        android:background="@color/colorWhite"
        android:id="@+id/footerText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="Remark (footer)"
        android:textAlignment="center"
        android:textColor="#888888"
        android:textSize="14sp"
        android:gravity="center"
        app:layout_constraintHeight_percent="0.10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
