                    android:textSize="36sp"
                    android:textStyle="normal"
                    android:background="@drawable/keypad_number_border"
                    android:textColor="@color/text_color_selector"
                    tools:ignore="ButtonStyle" />

                <!--<Button
                    android:id="@+id/button_delete_icon"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/keypad_delete_border"
                    android:textColor="@color/text_color_selector"
                    tools:ignore="ButtonStyle" />-->
                <!--<ImageButton
                    android:id="@+id/button_delete_icon"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/keypad_number_border"
                    android:contentDescription="deleteButton"
                    android:padding="25dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/del_icon"
                    tools:ignore="ButtonStyle" />-->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/keypad_number_border">

                    <ImageView
                        android:id="@+id/button_delete_icon"
                        android:layout_width="150dp"
                        android:layout_height="90dp"
                        android:layout_gravity="center"
                        android:src="@drawable/del_icon"
                        android:contentDescription="delete_icon"/>
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>