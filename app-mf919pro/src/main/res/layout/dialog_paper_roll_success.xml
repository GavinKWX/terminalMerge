<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="330dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@android:color/white"
    android:padding="24dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@mipmap/paperroll_success_header"
        android:scaleType="fitXY"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnReturn"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="44dp"
        android:text="Return"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/ai_round_theme_bg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pls kindly reach out helpdesk if\nyour previous request have not\nreceived\nPls expect 5-7 days delivery time"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#243740"
        android:gravity="center"
        android:layout_marginTop="56dp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:src="@mipmap/sharecomm_tpa_logo"
        android:scaleType="fitXY"
        android:layout_marginTop="90dp" />

</LinearLayout>