<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#CC1E656D" /> <!-- Change the color as needed -->
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@color/mf919_bg_theme_color" /> <!-- Change the color as needed -->
        </shape>
    </item>
</selector>