<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid
                android:color="@color/ButtonRippleColor"/>
            <corners
                android:radius="20dp" />
            <stroke
                android:width="3dp"
                android:color="@color/BoxRippleColor"/>
            <!--gradient
                android:startColor="@color/BoxColor"
                android:centerColor="@color/BoxGradientColor"
                android:endColor="@color/BoxColor"
                android:angle="90"/-->
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid
                android:color="@color/ButtonColor"/>
            <corners
                android:radius="20dp" />
            <stroke
                android:width="3dp"
                android:color="@color/BoxColor"/>
            <!--gradient
                android:startColor="@color/BoxColor"
                android:centerColor="@color/BoxGradientColor"
                android:endColor="@color/BoxColor"
                android:angle="90"/-->
        </shape>
    </item>
</selector>